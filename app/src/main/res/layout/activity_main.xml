<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Titulo principal -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titulo_panel"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- Nombre completo del alumno -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Jesús Isaai Rodríguez Santillán"
        android:textSize="16sp"
        android:layout_marginBottom="24dp" />

    <!-- Contenedor visual con fondo suave -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E8F0FE"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/tvEstadoModelo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/estado_inicial"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Boton para sincronizar datos -->
    <Button
        android:id="@+id/btnSincronizar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/texto_boton" />

</LinearLayout>